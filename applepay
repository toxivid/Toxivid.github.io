
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Take 50 Dollars</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #111;
      font-family: Arial, sans-serif;
    }

    .container {
      text-align: center;
    }

    #takeButton {
      width: 180px;
      height: 180px;
      border-radius: 50%;
      border: none;
      background: #e53935;
      color: white;
      font-size: 22px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
      transition: transform 0.15s, background 0.15s;
    }

    #takeButton:hover {
      background: #c62828;
      transform: scale(1.05);
    }

    #takeButton:active {
      transform: scale(0.95);
    }

    #result {
      display: none;
      margin-top: 30px;
      padding: 18px 30px;
      border-radius: 14px;
      background: #222;
      color: #4cff7a;
      font-size: 28px;
      font-weight: bold;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.35);
    }
  </style>
</head>

<body>

  <div class="container">
    <button id="takeButton">Take 50 dollars</button>
    <div id="result">+$50</div>
  </div>

  <audio id="audio">
    <source
      src="https://raw.githubusercontent.com/toxivid/-/main/applepay.mp3"
      type="audio/mpeg"
    >
  </audio>

  <script>
    const button = document.getElementById("takeButton");
    const audio = document.getElementById("audio");
    const result = document.getElementById("result");

    let total = 0;

    button.addEventListener("click", () => {
      total += 50;

      audio.currentTime = 0;
      audio.play();

      result.textContent = `+$${total}`;
      result.style.display = "block";
    });
  </script>

</body>
</html>
